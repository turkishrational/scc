                                                                	; eax = [u.break]
00000EB1: 83 C0 03                                              	add	eax,3
00000EB4: 24 FC                                                 	and	al,not 3 ; dword aligned allocation (malloc) address
                                                                
00000EB6: 50                                                    	push	eax ; *
00000EB7: 8B 44 24 08                                           	mov	eax,[esp+8] ; element size (integer=4)
00000EBB: 8B 5C 24 0C                                           	mov	ebx,[esp+12] ; structure/area length (element count)
00000EBF: F7 E3                                                 	mul	ebx
00000EC1: 03 04 24                                              	add	eax,[esp] ; *
                                                                
                                                                	; new break point - old break point = allocation size
                                                                
                                                                	; temporary - 23/09/2024
                                                                	;mov	[ubreak],eax
                                                                	;;;
                                                                	; temporary - 23/09/2024
                                                                	;xor	eax,eax
