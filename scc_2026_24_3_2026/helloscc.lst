                                                                	; return value
                                                                	; eax = start/beginning address
                                                                	;retn
                                                                	; 13/09/2024
00000ECE: 73 D2                                                 	jnc	short calloc_ok
                                                                
                                                                calloc_err:
                                                                	; write "malloc error" message to STDERR
00000ED0: BE F7 0E 00 00                                        	mov	esi,.malloc_err_msg
                                                                .calloc_err_p:
00000ED5: AC                                                    	lodsb
00000ED6: 08 C0                                                 	or	al,al
00000ED8: 74 10                                                 	jz	short .calloc_err_x
00000EDA: 89 C1 BB 03 00 00 00 B8 2E 00 00 00 CD 40             	sys	_stdio, 3, eax
00000EE8: EB EB                                                 	jmp	short .calloc_err_p
                                                                
                                                                .calloc_err_x:
00000EEA: BB FF FF FF FF B8 01 00 00 00 CD 40                   	sys	_exit, -1
00000EF6: C3                                                    	retn	; normally cpu must not come here !
                                                                
                                                                .malloc_err_msg:
00000EF7: 0D 0A                                                   db 0Dh,0Ah
00000EF9: 07                                                      db 07h  ; beep !
00000EFA: 4D 65 6D 6F 72 79 20 41 6C 6C 6F 63 61 74 69 6F         db "Memory Allocation Error!"
          6E 20 45 72 72 6F 72 21                               
00000F12: 0D 0A 00                                                db 0Dh,0Ah,0
                                                                
                                                                _OS_exit:
00000F15: 8B 5C 24 04                                           	mov	ebx,[esp+4]  ; exit code ; 13/09/2024
00000F19: B8 01 00 00 00 CD 40                                  	sys	_exit
00000F20: C3                                                    	retn	; normally cpu must not come here !
                                                                
                                                                
                                                                _fopen	equ _OS_fopen
                                                                _fputc	equ _OS_fputc
                                                                _fgetc	equ _OS_fgetc
                                                                _fclose equ _OS_fclos
                                                                
