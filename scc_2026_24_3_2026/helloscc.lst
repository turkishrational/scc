                                                                _OS_calloc:
                                                                	;Alloc memory
                                                                
                                                                	; TRDOS 386 v2 feature
                                                                	; default u.break (bss) address is file size for PRG files
                                                                
00000EA3: BB FF FF FF FF B8 11 00 00 00 CD 40                   	sys	_break, -1  ; get u.break address
00000EAF: 72 1F                                                 	jc	short calloc_err
                                                                
