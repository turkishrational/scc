                                                                init_osfunc:
                                                                	; 05/09/2024 - TRDOS 386 v2.0.9
                                                                	; nothing to do for now
00000DEA: C3                                                    	retn
                                                                
                                                                ;Main OS functions
                                                                
                                                                _OS_fopen:
                                                                	;Implement "fopen"
                                                                	;esp+4 - mode
                                                                	;esp+8 - file name
                                                                
00000DEB: 8B 44 24 04                                           	mov	eax,[esp+4] ; file open mode
00000DEF: 8B 5C 24 08                                           	mov	ebx,[esp+8] ; file name
                                                                
00000DF3: 31 C9                                                 	xor	ecx,ecx ; 0 ; open for read
00000DF5: 80 38 72                                              	cmp	byte [eax],'r'
00000DF8: 74 08                                                 	je	short open_read
                                                                	;inc	ecx ; 1 ; open for write
00000DFA: 80 38 77                                              	cmp	byte [eax],'w'
00000DFD: 74 0E                                                 	je	short open_write
                                                                	;bad mode
                                                                file_notfound:
                                                                access_error:
00000DFF: 31 C0                                                 	xor	eax,eax ; 0 ; invalid open mode
00000E01: C3                                                    	retn
                                                                
